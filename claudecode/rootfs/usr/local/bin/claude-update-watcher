#!/bin/bash
# claude-update-watcher: move idle Claude sessions onto an installed update.
#
# Claude Code updates itself in the background: it installs the new release
# over /usr/local/lib/node_modules/@anthropic-ai/claude-code, but every
# running session keeps executing the old binary until it is restarted. On an
# unattended box (Remote Control, a session pre-started at boot) nobody ever
# restarts it, so the session runs an old release indefinitely.
#
# Every POLL_SECS this looks at each tmux pane whose root is
# claude-auto-launch. When the pane's claude is running an older binary than
# the installed one, and the session is idle, it marks the pane and sends
# claude SIGTERM; claude-auto-launch sees the mark and relaunches the new
# release on the same conversation (claude-session-hook recorded its id).
#
# Idle means both:
#   - no turn in flight: the Stop hook stamped the last finished turn at or
#     after the last prompt. An interrupted turn fires no Stop hook, so a pane
#     that has been quiet for STALE_TURN_SECS counts as idle anyway. A turn
#     parked on an unanswered permission prompt looks the same, so the
#     question is dropped after that hour and asked again on resume;
#   - the pane has been quiet for IDLE_SECS: nothing printed (tmux
#     window_activity; Claude's spinner prints while it works) and nothing
#     typed by an attached client (session_activity).
#
# A release is only moved onto once `claude --version` answers from it, so a
# release that cannot run on this host (the AVX story in install-claude.sh)
# never takes a working session down. Started by claudecode-start when
# apply_claude_updates is on; stopped by its on_stop.
POLL_SECS=${CLAUDE_UPDATE_POLL_SECS:-60}
IDLE_SECS=${CLAUDE_UPDATE_IDLE_SECS:-900}
STALE_TURN_SECS=${CLAUDE_UPDATE_STALE_TURN_SECS:-3600}
PANES=${CLAUDE_PANE_STATE_DIR:-/run/claudecode/panes}
PROCS=${CLAUDE_PROC_STATE_DIR:-/run/claudecode/procs}
RC_PIDFILE=${CLAUDE_RC_SERVER_PIDFILE:-/run/claudecode/rc-server.pid}
BOOT=$(awk '/^btime/ {print $2}' /proc/stat)
HZ=$(getconf CLK_TCK 2>/dev/null || echo 100)

info() { echo "[$(date +%H:%M:%S)] [INFO] $*"; }
warn() { echo "[$(date +%H:%M:%S)] [WARN] $*"; }

BAD_RETRY_SECS=${CLAUDE_UPDATE_BAD_RETRY_SECS:-600}
verified=""   # "<key>:ok" or "<key>:bad:<epoch>" for the installed binary last checked
warned=""     # the key a "does not run here" warning was last logged for
signaled=" "  # pids already sent SIGTERM: a Claude winding down is not signalled again

# Sets BIN to the installed binary once it is known to run. Fails while an
# update is mid-install or when the new release does not run here. Not called
# in a subshell: the verdict is cached in $verified.
#
# The cache key is inode, size and mtime, so a binary npm was still writing
# when it was first checked is checked again as soon as it is complete. A
# failure is retried after BAD_RETRY_SECS, so a transient one (the 30 s
# timeout under load) does not strand sessions until the next release; one
# that keeps failing, like a release without AVX support, is logged once.
installed_ok() {
  local bin key out now
  bin=$(readlink -f "$(command -v claude)" 2>/dev/null) || return 1
  [ -x "$bin" ] || return 1
  key=$(stat -c '%i-%s-%Y' "$bin" 2>/dev/null) || return 1
  now=$(date +%s)
  case $verified in
    "$key:ok") BIN=$bin; return 0 ;;
    "$key:bad:"*) [ $((now - ${verified##*:})) -lt "$BAD_RETRY_SECS" ] && return 1 ;;
  esac
  if out=$(timeout 30 "$bin" --version < /dev/null 2>&1); then
    verified="$key:ok"
    INSTALLED_VERSION=${out%% *}
    BIN=$bin
    info "Claude Code $INSTALLED_VERSION is installed; idle sessions on an older release will be restarted onto it"
  else
    verified="$key:bad:$now"
    if [ "$warned" != "$key" ]; then
      warned=$key
      warn "The installed Claude Code does not run here ($(printf '%s' "$out" | tail -1)); sessions stay on the release they run, and it is checked again every ${BAD_RETRY_SECS}s"
    fi
    return 1
  fi
}

# The pane's claude: the child of the claude-auto-launch root whose executable
# is (or was, before the update deleted it) the npm-installed Claude Code.
pane_claude() {  # $1 = pane root pid
  local kid exe
  for kid in $(pgrep -P "$1" 2>/dev/null); do
    exe=$(readlink "/proc/$kid/exe" 2>/dev/null) || continue
    case $exe in */@anthropic-ai/*) echo "$kid"; return 0 ;; esac
  done
  return 1
}

# The Remote Control server (remote_control_server) is restarted onto an
# update only when every session it has spawned is idle: no turn in flight,
# and no prompt, finished turn or (re)start for IDLE_SECS. Its sessions
# survive the restart - the server keeps its environment and reattaches them
# - but a turn in flight would be cut off. claude-session-hook stamps those
# sessions per Claude process, since they have no tmux pane.
descendants() {  # $1 = pid -> every descendant pid
  local kid
  for kid in $(pgrep -P "$1" 2>/dev/null); do echo "$kid"; descendants "$kid"; done
}
server_idle() {  # $1 = server pid
  local kid lp ls started last now
  now=$(date +%s)
  # All descendants, not just children: a release that spawns sessions
  # through an intermediate process must not look like a server with none.
  for kid in $(descendants "$1"); do
    case $(readlink "/proc/$kid/exe" 2>/dev/null) in */@anthropic-ai/*) ;; *) continue ;; esac
    lp=$(cat "$PROCS/$kid/last-prompt" 2>/dev/null || echo 0)
    ls=$(cat "$PROCS/$kid/last-stop" 2>/dev/null || echo 0)
    started=$(( BOOT + $(awk '{sub(/.*\) /, ""); print $20}' "/proc/$kid/stat" 2>/dev/null || echo 0) / HZ ))  # starttime; comm may hold spaces
    last=$lp; [ "$ls" -gt "$last" ] && last=$ls; [ "$started" -gt "$last" ] && last=$started
    if [ "$lp" -gt "$ls" ] && [ $((now - lp)) -lt "$STALE_TURN_SECS" ]; then return 1; fi
    [ $((now - last)) -ge "$IDLE_SECS" ] || return 1
  done
  return 0
}

while sleep "$POLL_SECS"; do
  installed_ok || continue
  now=$(date +%s)
  while read -r pane root win_act sess_act; do
    case $(tr '\0' ' ' < "/proc/$root/cmdline" 2>/dev/null) in
      *claude-auto-launch*) ;;
      *) continue ;;   # a shell or a claude started by hand: nobody would relaunch it
    esac
    pid=$(pane_claude "$root") || continue
    case $signaled in *" $pid "*) continue ;; esac
    [ "/proc/$pid/exe" -ef "$BIN" ] && continue   # already on the installed release
    quiet=$(( now - (win_act > sess_act ? win_act : sess_act) ))
    [ "$quiet" -ge "$IDLE_SECS" ] || continue
    state=$PANES/${pane#%}
    last_prompt=$(cat "$state/last-prompt" 2>/dev/null || echo 0)
    last_stop=$(cat "$state/last-stop" 2>/dev/null || echo 0)
    if [ "$last_prompt" -gt "$last_stop" ] && [ "$quiet" -lt "$STALE_TURN_SECS" ]; then
      continue   # a turn is in flight
    fi
    # The installed release may have changed since the top of this round:
    # check it again (cached unless the file changed) so a session is only
    # ever moved onto a release that has answered --version.
    installed_ok || break
    [ "/proc/$pid/exe" -ef "$BIN" ] && continue
    mkdir -p "$state" 2>/dev/null && touch "$state/restart-for-update" 2>/dev/null || {
      warn "Cannot mark pane $pane for restart; leaving it on the older release"
      continue
    }
    info "Restarting the Claude session in pane $pane (pid $pid, idle ${quiet}s) onto Claude Code ${INSTALLED_VERSION:-update}; it resumes the same conversation"
    if kill -TERM "$pid" 2>/dev/null; then
      signaled="$signaled$pid "
    else
      rm -f "$state/restart-for-update"   # it exited by itself meanwhile
    fi
  done < <(tmux list-panes -a -F '#{pane_id} #{pane_pid} #{window_activity} #{session_activity}' 2>/dev/null)

  rpid=$(cat "$RC_PIDFILE" 2>/dev/null)
  case $signaled in *" $rpid "*) rpid="" ;; esac
  if [ -n "$rpid" ] && [ -e "/proc/$rpid/exe" ] && ! [ "/proc/$rpid/exe" -ef "$BIN" ] \
     && server_idle "$rpid" && installed_ok && ! [ "/proc/$rpid/exe" -ef "$BIN" ]; then
    info "Restarting the Remote Control server (pid $rpid) onto Claude Code ${INSTALLED_VERSION:-update}; its sessions are idle and reattach"
    kill -TERM "$rpid" 2>/dev/null && signaled="$signaled$rpid "
  fi
  # Forget pids that have exited, so a later Claude the kernel hands the same
  # pid is not mistaken for one already signalled and left on an old release.
  for p in $signaled; do [ -e "/proc/$p" ] || signaled=${signaled/ $p / }; done
  # State of Claude processes that have exited.
  for d in "$PROCS"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}; [ -e "/proc/${d##*/}" ] || rm -rf "$d"
  done
done
